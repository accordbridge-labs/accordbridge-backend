{
  "name": "accordbridge-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "test:testnet": "npm run build && node --env-file=.env.test scripts/testnet-smoke.mjs",
    "docs:api": "npm run build && node dist/src/openapi.js",
    "start": "node --env-file=.env dist/src/main.js",
    "dev": "npm run build && npm start",
    "db:local": "node scripts/local-db.mjs",
    "db:migrate": "npm run build && node --env-file=.env dist/src/migrate.js",
    "test": "npm run build && node --env-file=.env.test --test dist/test/*.test.js",
    "format": "prettier --write src test scripts *.json",
    "format:check": "prettier --check src test scripts *.json",
    "start:hosted": "node dist/src/migrate.js && node dist/src/main.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/throttler": "6.7.1",
    "@stellar/stellar-sdk": "17.2.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
